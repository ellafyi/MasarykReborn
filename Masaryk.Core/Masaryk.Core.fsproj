<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Starboard\Domain.fs"/>
        <Compile Include="Starboard\Evaluation.fs"/>
        <Compile Include="Starboard\Configuration.fs"/>
        <Compile Include="Starboard\Runtime.fs"/>
        <Compile Include="Starboard\Events.fs"/>
        <Compile Include="Starboard\DiscordAdapter.fs"/>
        <Compile Include="Command.fs"/>
        <Compile Include="Commands\Cummy.fs"/>
        <Compile Include="Commands\Test.fs"/>
        <Compile Include="Commands\Starboard.fs"/>
        <Compile Include="CommandRegistry.fs"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Program.fs"/>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
        <Content Include="Dockerfile"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Discord.Net" Version="3.20.1"/>
        <ProjectReference Include="..\Masaryk.Postgres\Masaryk.Postgres.fsproj"/>
    </ItemGroup>

</Project>
