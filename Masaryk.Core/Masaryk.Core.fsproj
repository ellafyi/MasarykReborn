<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Command.fs" />
        <Compile Include="Services\Shared\MessageEmbed.fs" />
        <Compile Include="Services\Shared\Worker.fs" />
        <Compile Include="Services\Shared\Replies.fs" />
        <Compile Include="Services\Starboard\Domain.fs" />
        <Compile Include="Services\Starboard\Evaluation.fs" />
        <Compile Include="Services\Starboard\Configuration.fs" />
        <Compile Include="Services\Starboard\DiscordAdapter.fs" />
        <Compile Include="Services\Starboard\Rendering.fs" />
        <Compile Include="Services\Starboard\Capture.fs" />
        <Compile Include="Services\Starboard\SlashCommand.fs" />
        <Compile Include="Services\Starboard\Feature.fs" />
        <Compile Include="Services\Bookmarks.fs" />
        <Compile Include="Services\Chat.fs" />
        <Compile Include="Services\Leaderboard\Counting.fs" />
        <Compile Include="Services\Leaderboard\Ranking.fs" />
        <Compile Include="Services\Leaderboard\SlashCommand.fs" />
        <Compile Include="Services\Leaderboard\Import.fs" />
        <Compile Include="Services\Leaderboard\Feature.fs" />
        <Compile Include="Services\Fun\Feature.fs" />
        <Compile Include="Services\Courses\Export.fs" />
        <Compile Include="Services\Courses\Import.fs" />
        <Compile Include="Services\Courses\Channels.fs" />
        <Compile Include="Services\Courses\Guild.fs" />
        <Compile Include="Services\Courses\Listing.fs" />
        <Compile Include="Services\Courses\SlashCommand.fs" />
        <Compile Include="Services\Courses\Feature.fs" />
        <Compile Include="Commands\Cummy.fs" />
        <Compile Include="Commands\Test.fs" />
        <Compile Include="CommandRegistry.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Program.fs" />
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
        <Content Include="Dockerfile" />
        <EmbeddedResource Include="Assets\night_sky.txt" LogicalName="night_sky.txt" />
        <EmbeddedResource Include="Assets\hugs.txt" LogicalName="hugs.txt" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Discord.Net" Version="3.20.1" />
        <ProjectReference Include="..\Masaryk.Postgres\Masaryk.Postgres.fsproj" />
    </ItemGroup>

</Project>
