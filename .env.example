BOT_TOKEN=your-discord-bot-token
GUILD_ID=your-guild-id
# Language model replies (MasarykTraining inference server). Leave LLM_API_URL empty to disable.
# From Compose on Docker Desktop: http://host.docker.internal:8000/v1; bot run locally: http://127.0.0.1:8000/v1
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=masaryk
POSTGRES_USER=masaryk
POSTGRES_DB=masaryk
POSTGRES_PASSWORD=replace-with-a-local-password
