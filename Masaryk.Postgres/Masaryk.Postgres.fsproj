<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Database.fs"/>
        <Compile Include="Sql.fs"/>
        <Compile Include="StarboardRepository.fs"/>
        <Compile Include="ChatRepository.fs"/>
        <Compile Include="LeaderboardRepository.fs"/>
        <Compile Include="LegacyImport.fs"/>
        <Compile Include="CourseRepository.fs"/>
        <Compile Include="ConfigurationRepository.fs"/>
        <Compile Include="LockoutRepository.fs"/>
        <Compile Include="JobRepository.fs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Masaryk.IS\Masaryk.IS.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Migrations/001_initial_schema.sql" />
        <EmbeddedResource Include="Migrations/002_starboard_publication.sql" />
        <EmbeddedResource Include="Migrations/003_starboard_author_avatar.sql" />
        <EmbeddedResource Include="Migrations/004_starboard_reply_context.sql" />
        <EmbeddedResource Include="Migrations/005_llm_reply.sql" />
        <EmbeddedResource Include="Migrations/006_leaderboard.sql" />
        <EmbeddedResource Include="Migrations/007_starboard_posts.sql" />
        <EmbeddedResource Include="Migrations/008_course_channels.sql" />
        <EmbeddedResource Include="Migrations/009_legacy_starboard_posts.sql" />
        <EmbeddedResource Include="Migrations/010_guild_settings.sql" />
        <EmbeddedResource Include="Migrations/011_configuration.sql" />
        <EmbeddedResource Include="Migrations/012_course_names.sql" />
        <EmbeddedResource Include="Migrations/013_lockout.sql" />
        <EmbeddedResource Include="Migrations/014_lockout_overwrites.sql" />
        <EmbeddedResource Include="Migrations/015_course_members.sql" />
        <EmbeddedResource Include="Migrations/016_course_prune.sql" />
        <EmbeddedResource Include="Migrations/017_scheduled_jobs.sql" />
        <PackageReference Include="Npgsql" Version="10.0.1" />
    </ItemGroup>

</Project>
