<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Library.fs"/>
        <Compile Include="Sql.fs"/>
        <Compile Include="Starboard.fs"/>
        <Compile Include="StarboardRepository.fs"/>
        <Compile Include="ChatRepository.fs"/>
        <Compile Include="LeaderboardRepository.fs"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Migrations/001_initial_schema.sql" />
        <EmbeddedResource Include="Migrations/002_starboard_publication.sql" />
        <EmbeddedResource Include="Migrations/003_starboard_author_avatar.sql" />
        <EmbeddedResource Include="Migrations/004_starboard_reply_context.sql" />
        <EmbeddedResource Include="Migrations/005_llm_reply.sql" />
        <EmbeddedResource Include="Migrations/006_leaderboard.sql" />
        <PackageReference Include="Npgsql" Version="10.0.1" />
    </ItemGroup>

</Project>
